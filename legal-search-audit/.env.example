# ==========================================================================
# legal-search-audit — environment configuration (example)
# Copy this file to ".env" and adjust as needed. ALL values are optional.
# The tool runs fully without a .env file using the defaults in src/config.ts.
# ==========================================================================

# --- Browser / run behaviour -----------------------------------------------
# Run the browser without a visible window (true) or with a window (false).
HEADLESS=true

# Delay between page requests, in milliseconds. Keep this HIGH and POLITE.
# The spec requires roughly one request every 5–10 seconds.
DELAY_MS=7000

# Per-page navigation timeout in milliseconds.
PAGE_TIMEOUT_MS=45000

# Stop the whole run immediately when a block / captcha / login-wall is found.
STOP_ON_BLOCK=true

# Save full-page screenshots (true/false).
SAVE_SCREENSHOTS=true

# A descriptive, honest User-Agent suffix. NEVER use this to disguise the bot
# as a real browser in a misleading way — it is appended for transparency.
UA_SUFFIX=legal-search-audit/1.0 (UX research; respectful low-rate)

# --- OPTIONAL authorised credentials ---------------------------------------
# ONLY fill these in if the project owner has explicitly provided an
# authorised account. The tool will NOT bypass any paywall or subscription.
# Leaving them empty (the default) means the tool only inspects public pages.
QANONIAH_USERNAME=
QANONIAH_PASSWORD=
QISTAS_USERNAME=
QISTAS_PASSWORD=
