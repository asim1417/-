# ── قاعدة البيانات (PostgreSQL + pgvector) ──
DATABASE_URL="postgresql://miftah:miftah@localhost:5432/miftah?schema=public"

# ── مفتاح Anthropic لمحرك «المرشد الطبي التعليمي» ──
ANTHROPIC_API_KEY="sk-ant-xxxxxxxx"
ANTHROPIC_MODEL="claude-sonnet-5"          # بدائل: claude-haiku-4-5-20251001 (أوفر) / claude-opus-4-8 (أقوى)

# ── (اختياري) مزوّد التضمينات للبحث الدلالي pgvector ──
# EMBEDDINGS_PROVIDER="voyage"             # voyage | none  (الافتراضي none => بحث نصّي)
# VOYAGE_API_KEY="pa-xxxx"

# ── مصادر المحتوى المفتوحة ──
NCBI_API_KEY=""                            # اختياري: يرفع حد PubMed من 3 إلى 10 طلبات/ثانية
CONTACT_EMAIL="platform@miftah.example"    # مطلوب في User-Agent لواجهات NLM/NCBI

# ── المصادقة ولوحة التحكم ──
AUTH_SECRET="ضع-سرًّا-عشوائيًا-طويلًا-هنا"
ADMIN_PASSCODE="medkey-admin"          # رمز دخول الطاقم (غيّره قبل الإطلاق)
